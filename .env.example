# === Required: Telegram Bot ===
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_BOT_NAME=your_bot_display_name
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_SECRET_TOKEN=your_secret_token

# === Required: LLM intent classification (Groq free tier) ===
GROQ_API_KEY=your_groq_api_key

# === Required: ngrok tunnel for Telegram webhook (local dev) ===
NGROK_AUTHTOKEN=your_ngrok_authtoken
DEFAULT_TENANT_ID=a0000000-0000-0000-0000-000000000001

# === Optional overrides (have sensible defaults) ===
# POSTGRES_DB=barberbot
# POSTGRES_USER=barberbot
# POSTGRES_PASSWORD=barberbot
# RABBITMQ_USERNAME=guest
# RABBITMQ_PASSWORD=guest
# JWT_SECRET=barberbot-dev-secret-key-change-in-production-minimum-256-bits-long
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
